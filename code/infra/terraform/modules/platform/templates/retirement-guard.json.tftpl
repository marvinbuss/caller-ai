[
  {
    "apiVersion": "admissionregistration.k8s.io/v1",
    "kind": "ValidatingAdmissionPolicy",
    "metadata": {"name": "${policy_name}"},
    "spec": {
      "failurePolicy": "Fail",
      "matchConstraints": {
        "matchPolicy": "Equivalent",
        "resourceRules": [
          {"apiGroups": [""], "apiVersions": ["v1"], "operations": ["DELETE"], "resources": ["pods"], "scope": "Namespaced"},
          {"apiGroups": [""], "apiVersions": ["v1"], "operations": ["CREATE"], "resources": ["pods/eviction"], "scope": "Namespaced"}
        ]
      },
      "matchConditions": [{"name": "protected-namespace", "expression": "request.namespace == '${namespace}'"}],
      "validations": [{
        "expression": "request.operation == 'DELETE' && request.subResource == '' && request.userInfo.username == '${controller_subject}' && request.name != '' && has(request.options.preconditions) && has(request.options.preconditions.uid) && request.options.preconditions.uid != '' && (!has(request.options.gracePeriodSeconds) || request.options.gracePeriodSeconds > 0)",
        "reason": "Forbidden",
        "message": "Planned removal requires the guarded retirement controller and exact pod UID."
      }]
    }
  },
  {
    "apiVersion": "admissionregistration.k8s.io/v1",
    "kind": "ValidatingAdmissionPolicyBinding",
    "metadata": {"name": "${policy_name}"},
    "spec": {"policyName": "${policy_name}", "validationActions": ["Deny"]}
  }
]

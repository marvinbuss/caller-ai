{
  "version": 1,
  "aliasPattern": "^[a-z][a-z0-9-]{2,62}$",
  "rules": [
    {"id": "private_key_pem", "kind": "pattern", "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |ENCRYPTED )?PRIVATE KEY-----"},
    {"id": "uri_userinfo", "kind": "uri_userinfo"},
    {"id": "connection_string", "kind": "pattern", "pattern": "\\b(?:Password|Pwd|AccountKey|SharedAccessKey)\\s*=\\s*[^\\s;]+"},
    {"id": "sas_signature", "kind": "uri_signature"},
    {"id": "bearer_token", "kind": "pattern", "pattern": "\\bBearer[ \\t]+[A-Za-z0-9._~+/=-]{16,}"}
  ]
}
